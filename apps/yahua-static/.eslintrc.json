{
  "root": true,
  "extends": [
    "eslint:recommended",
    "plugin:sonarjs/recommended-legacy",
    "plugin:security/recommended-legacy"
  ],
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "env": {
    "node": true,
    "es2022": true
  },
  "ignorePatterns": [
    "public/**",
    "coverage/**",
    "node_modules/**"
  ],
  "overrides": [
    {
      "files": [
        "assets/**/*.js"
      ],
      "env": {
        "browser": true,
        "node": false
      }
    },
    {
      "files": [
        "tests/**/*.js",
        "tests/**/*.mjs"
      ],
      "parserOptions": {
        "sourceType": "module"
      },
      "env": {
        "node": true,
        "browser": true
      },
      "rules": {
        "sonarjs/no-duplicate-string": "off"
      }
    }
  ]
}
