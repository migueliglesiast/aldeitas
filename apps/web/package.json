{
  "name": "aldeitas-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "export": "next build",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:push:postgres": "prisma db push --schema prisma/schema.postgres.prisma",
    "generate:postgres": "prisma generate --schema prisma/schema.postgres.prisma",
    "seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts",
    "fix-rooms": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/fix-room-names.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:setup": "prisma db push --force-reset --skip-generate && ts-node --compiler-options '{\"module\":\"CommonJS\"}' e2e/seed.ts && next build"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "axios": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0",
    "date-fns": "^3.6.0",
    "ical-generator": "^3.6.1",
    "next": "^16.0.0",
    "node-ical": "^0.27.1",
    "nodemailer": "^9.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^16.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.5.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.5.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^20.14.12",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "jest-axe": "^11.0.0",
    "jsdom": "25.0.1",
    "postcss": "^8.4.41",
    "prisma": "^6.14.0",
    "tailwindcss": "^3.4.10",
    "ts-node": "^10.9.2"
  }
}
