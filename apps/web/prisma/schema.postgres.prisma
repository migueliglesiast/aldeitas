// Production schema: PostgreSQL.
// Keep models in sync with schema.prisma (sqlite for local/test/e2e).
generator client {
  provider      = "prisma-client-js"
  // Hostinger Linux + local macOS during generate
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String         @id @default(cuid())
  username         String         @unique
  email            String         @unique
  passwordHash     String
  hotelName        String?
  phoneNumber      String?
  instagramLink    String?
  shortDescription String?
  publicAmenities  String?
  fullName         String?
  nickname         String?
  verified         Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  sessions         Session[]
  hotelManagers    HotelManager[]
  ownedHotels      Hotel[]        @relation("HotelOwner")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  sessionToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model Hotel {
  id                   String              @id @default(cuid())
  name                 String
  slug                 String              @unique
  customDomain         String?             @unique
  description          String
  descriptionEn        String?
  descriptionEs        String?
  location             String
  storefrontTagline    String?
  googleMapsUrl        String?
  latitude             Float?
  longitude            Float?
  googleDriveFolderId  String?
  coverImageUrl        String?
  logoImageUrl         String?
  mainContactNumber    String?
  ownerId              String?
  owner                User?               @relation("HotelOwner", fields: [ownerId], references: [id])
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  listings             Listing[]
  contacts             HotelContact[]
  images               HotelImage[]
  managers             HotelManager[]
  calendarShare        HotelCalendarShare?
  manualBlocks         ManualBlock[]
  ghostBookings        GhostBooking[]
  gmailSyncEmail       String?
  gmailSyncPasswordEnc String?
  gmailSyncEnabled     Boolean             @default(false)
  gmailSyncLastAt      DateTime?
  gmailSyncLastError   String?
  gmailSyncOffset      Int                 @default(0)
  addons               HotelAddon[]
}

model HotelCalendarShare {
  id        String   @id @default(cuid())
  hotelId   String   @unique
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ManualBlock {
  id        String   @id @default(cuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId, startDate, endDate])
  @@index([hotelId])
}

model GhostBooking {
  id             String   @id @default(cuid())
  hotelId        String
  hotel          Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  listingId      String
  listing        Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  startDate      DateTime
  endDate        DateTime
  guestName      String
  guestCount     Int?
  payoutCents    Int?
  payoutCurrency String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([listingId, startDate, endDate])
  @@index([hotelId])
}

model ListingDailyPrice {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  date       DateTime
  priceCents Int
  currency   String   @default("MXN")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([listingId, date])
  @@index([listingId, date])
}

model HotelManager {
  id        String   @id @default(cuid())
  userId    String
  hotelId   String
  user      User     @relation(fields: [userId], references: [id])
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, hotelId])
}

model HotelContact {
  id        String   @id @default(cuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  type      String
  name      String
  phone     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HotelImage {
  id        String   @id @default(cuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model Listing {
  id                   String              @id @default(cuid())
  hotelId              String
  hotel                Hotel               @relation(fields: [hotelId], references: [id])
  airbnbId             String
  airbnbUrl            String
  icalUrl              String?
  title                String
  description          String?
  descriptionEn        String?
  descriptionEs        String?
  baseCurrency         String              @default("MXN")
  nightlyBasePrice     Int                 @default(0)
  guestsInBeds         Int?
  guestsInBedsAndSofas Int?
  numberOfBeds         Int?
  numberOfBathrooms    Float?
  bedType              String?
  images               Image[]
  calendarSources      CalendarSource[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  bookings             Booking[]
  manualBlocks         ManualBlock[]
  ghostBookings        GhostBooking[]
  dailyPrices          ListingDailyPrice[]
  guestMetas           CalendarGuestMeta[]
  reviews              ListingReview[]
  ratingSummary        ListingRatingSummary?
}

model CalendarGuestMeta {
  id              String   @id @default(cuid())
  listingId       String
  listing         Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  startDate       DateTime
  endDate         DateTime
  guestName       String?
  guestCount      Int?
  payoutCents     Int?
  payoutCurrency  String?
  sourceUid       String?
  yearNeedsReview Boolean  @default(false)
  yearReviewNote  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([listingId, startDate, endDate])
  @@index([listingId, startDate, endDate])
  @@index([yearNeedsReview])
}

model Image {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])
  url       String
  position  Int
}

model CalendarSource {
  id        String   @id @default(cuid())
  name      String
  icalUrl   String   @unique
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id])
  createdAt DateTime @default(now())
}

model Booking {
  id                     String        @id @default(cuid())
  listingId              String
  listing                Listing       @relation(fields: [listingId], references: [id])
  guestEmail             String
  guestPhone             String
  guestName              String?
  guestCount             Int?
  startDate              DateTime
  endDate                DateTime
  totalPriceCents        Int
  currency               String        @default("MXN")
  paymentProvider        String?
  paymentOrderId         String?
  paymentReference       String?
  authorizedAt           DateTime?
  confirmedAt            DateTime?
  pendingExpiresAt       DateTime?
  cancelReason           String?
  externalBlocksSnapshot String?
  lastReconciledAt       DateTime?
  status                 BookingStatus @default(PENDING)
  createdAt              DateTime      @default(now())
  addons                 BookingAddon[]
}

/// Extras a hotel sells with a stay (moto rental, beer in the fridge, tours...).
model HotelAddon {
  id          String         @id @default(cuid())
  hotelId     String
  hotel       Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name        String
  nameEn      String?
  description String?
  emoji       String?
  priceCents  Int
  currency    String         @default("MXN")
  /// "item" | "night" | "person" | "person_night"
  unit        String         @default("item")
  maxQuantity Int            @default(10)
  /// Units the hotel owns at once (e.g. 2 motos); null means unlimited.
  stock       Int?
  enabled     Boolean        @default(true)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  bookings    BookingAddon[]

  @@index([hotelId])
}

model BookingAddon {
  id             String     @id @default(cuid())
  bookingId      String
  booking        Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addonId        String
  addon          HotelAddon @relation(fields: [addonId], references: [id])
  name           String
  unit           String
  quantity       Int
  unitPriceCents Int
  totalCents     Int
  createdAt      DateTime   @default(now())

  @@index([bookingId])
  @@index([addonId])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELED
}

model ListingReview {
  id           String   @id @default(cuid())
  listingId    String
  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  source       String   @default("airbnb")
  externalId   String
  rating       Int?
  comments     String
  language     String?
  reviewerName String?
  reviewedAt   DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([listingId, externalId])
  @@index([listingId, reviewedAt])
}

model ListingRatingSummary {
  listingId     String   @id
  listing       Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  source        String   @default("airbnb")
  overall       Float?
  reviewCount   Int?
  cleanliness   Float?
  accuracy      Float?
  checkin       Float?
  communication Float?
  location      Float?
  value         Float?
  updatedAt     DateTime @updatedAt
}
