# Database (Neon in production)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Public site URL (no trailing slash) — required for booking links in emails
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Mercado Pago — https://www.mercadopago.com.mx/developers
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
PAYMENT_PROVIDER=mercadopago
# MERCADOPAGO_TEST_PAYER_EMAIL=test@testuser.com
# Webhook secret from Your integrations → Webhooks (verifies x-signature)
# MERCADOPAGO_WEBHOOK_SECRET=
# Force sandbox behaviour (test payer email) when running TEST credentials with NODE_ENV=production
# MERCADOPAGO_SANDBOX=true

# Booking reconcile secret (app.js also runs reconcile in-process every BOOKING_RECONCILE_INTERVAL_MINUTES)
BOOKING_RECONCILE_SECRET=
# BOOKING_RECONCILE_INTERVAL_MINUTES=5

# Optional: Airbnb price sync cron (falls back to BOOKING_RECONCILE_SECRET)
# AIRBNB_PRICE_SYNC_SECRET=

# Optional: encrypt Gmail App Passwords at rest (falls back to BOOKING_RECONCILE_SECRET)
# GMAIL_SYNC_SECRET=

# Booking timing (minutes)
BOOKING_MIN_CONFIRM_MINUTES=15
BOOKING_MAX_PENDING_MINUTES=120

# Email (SMTP) — see EMAIL_SETUP.md
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Aldeitas <noreply@yourdomain.com>"
EMAIL_REPLY_TO=
# Optional: comma-separated staff inbox override (otherwise hotel owner + managers)
BOOKING_NOTIFY_EMAIL=

# Optional: Cloudinary for durable admin uploads in production
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# WhatsApp guest agent (Meta Cloud API). Off until ACCESS_TOKEN and PHONE_NUMBER_ID are set.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Bot number in international digits (e.g. 5295XXXXXXXX), used for room QR links
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_ROOM_CODE_SECRET=
# Fallback host when a hotel has no main contact number
WHATSAPP_DEFAULT_HOST_PHONE=
# Providers sheet published as CSV (File > Share > Publish to web > CSV)
WHATSAPP_PROVIDERS_SHEET_CSV_URL=
# WHATSAPP_EMERGENCY_TIMEOUT_MINUTES=10
# WHATSAPP_HOST_REMINDER_MINUTES=30
# Approved template names (defaults: aldeitas_booking_welcome, aldeitas_checkin_info, aldeitas_checkout_goodbye, aldeitas_host_question, aldeitas_emergency_alert)
# WHATSAPP_TEMPLATE_WELCOME=

# Agent LLM: any OpenAI-compatible API. Default primary is Groq (Qwen), fallback Z.ai (GLM Flash).
AGENT_LLM_API_KEY=
# AGENT_LLM_BASE_URL=https://api.groq.com/openai/v1
# AGENT_LLM_MODEL=qwen/qwen3.8-27b
AGENT_LLM_FALLBACK_API_KEY=
# AGENT_LLM_FALLBACK_BASE_URL=https://api.z.ai/api/paas/v4
# AGENT_LLM_FALLBACK_MODEL=glm-4.7-flash
