{
  "name": "aldeitas",
  "version": "1.0.0",
  "private": true,
  "description": "Aldeitas monorepo: Next.js booking platform (apps/web)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "e2e": "npm run e2e --workspace apps/web"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "8.57.1",
    "eslint-plugin-security": "3.0.1",
    "eslint-plugin-sonarjs": "1.0.4",
    "prettier": "3.3.3",
    "typescript": "5.5.4",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "glob": "^11.0.0",
    "vite": "^7.1.0",
    "minimatch@10": "^10.2.6"
  }
}
