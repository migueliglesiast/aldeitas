{
  "name": "casa_yahua",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0",
    "start:prod": "prisma db push && next start -H 0.0.0.0",
    "export": "next build",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts",
    "fix-rooms": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/fix-room-names.ts",
    "reconcile-bookings": "ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\"}' scripts/reconcile-pending-bookings.ts",
    "migrate-currency-to-mxn": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/migrate-currency-to-mxn.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "axios": "^1.7.4",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0",
    "date-fns": "^3.6.0",
    "ical-generator": "^3.6.1",
    "leaflet": "^1.9.4",
    "next": "^14.2.5",
    "node-ical": "^0.18.0",
    "nodemailer": "^6.9.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.14.12",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.41",
    "prisma": "^6.14.0",
    "tailwindcss": "^3.4.10",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  }
}
