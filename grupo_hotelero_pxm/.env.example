# Database (PostgreSQL — required)
#
# Local: docker compose up -d  →  use URLs below (same host for both)
# Neon + Vercel:
#   DATABASE_URL = pooled connection (host contains "-pooler")
#   DIRECT_URL   = direct connection (no "-pooler") — used by prisma db push at build time
#
DATABASE_URL="postgresql://casayahua:casayahua@localhost:5432/casayahua"
DIRECT_URL="postgresql://casayahua:casayahua@localhost:5432/casayahua"

# Public site URL (no trailing slash). Set in Vercel before deploy — baked into the client bundle.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Mercado Pago — https://www.mercadopago.com.mx/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
PAYMENT_PROVIDER=mercadopago

# Production only: remove or leave unset
# MERCADOPAGO_TEST_PAYER_EMAIL=test@testuser.com

# Booking reconcile — required in production
# Vercel Cron calls GET /api/bookings/reconcile (uses CRON_SECRET automatically)
# Manual / external cron: POST with ?secret=BOOKING_RECONCILE_SECRET
BOOKING_RECONCILE_SECRET=

# Booking timing (minutes) — production defaults
BOOKING_MIN_CONFIRM_MINUTES=15
BOOKING_MAX_PENDING_MINUTES=120

# Email (optional locally; required in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Aldeitas <bookings@yourdomain.com>"

# Optional: Airbnb dynamic pricing via RapidAPI
# AIRBNB_RAPIDAPI_KEY=

# Vercel sets these automatically — do not add locally
# VERCEL=1
# VERCEL_URL=your-project.vercel.app
# CRON_SECRET=...  (injected when vercel.json crons are enabled)
